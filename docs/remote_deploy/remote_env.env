# ============================================================================
# FINERACT API CONFIGURATION
# ============================================================================

# Comma-separated list of Fineract API URLs (for server switching)
FINERACT_API_URLS=https://backend.credesal.com

# Primary Fineract API URL
FINERACT_API_URL=https://backend.credesal.com

# API provider path
FINERACT_API_PROVIDER=/fineract-provider/api

# API version
FINERACT_API_VERSION=/v1

# ============================================================================
# TENANT CONFIGURATION
# ============================================================================

# Default tenant identifier
FINERACT_PLATFORM_TENANT_IDENTIFIER=default

# Comma-separated list of tenant identifiers
FINERACT_PLATFORM_TENANTS_IDENTIFIER=default

# ============================================================================
# LANGUAGE CONFIGURATION
# ============================================================================

# Default language
MIFOS_DEFAULT_LANGUAGE=en-US

# Supported languages (comma-separated)
MIFOS_SUPPORTED_LANGUAGES=cs-CS,de-DE,en-US,es-MX,fr-FR,it-IT,ko-KO,lt-LT,lv-LV,ne-NE,pt-PT,sw-SW

# ============================================================================
# APPLICATION SETTINGS
# ============================================================================

# Preload clients on startup
MIFOS_PRELOAD_CLIENTS=true

# Default CSV delimiter
MIFOS_DEFAULT_CHAR_DELIMITER=,

# Allow server switching in UI
MIFOS_ALLOW_SERVER_SWITCH=true

# Display backend info
MIFOS_DISPLAY_BACKEND_INFO=true

# Display tenant selector
MIFOS_DISPLAY_TENANT_SELECTOR=true

# Wait time for notifications (seconds)
MIFOS_WAIT_TIME_FOR_NOTIFICATIONS=60

# Wait time for COB catch-up (seconds)
MIFOS_WAIT_TIME_FOR_CATCHUP=30

# Session idle timeout (milliseconds) - 30 minutes default
MIFOS_SESSION_IDLE_TIMEOUT=1800000

# Minimum password length
MIFOS_MIN_PASSWORD_LENGTH=12

# Enable HTTP cache
MIFOS_HTTP_CACHE_ENABLED=true

# Enable warning dialog
MIFOS_WARNING_DIALOG_ENABLED=true

# ============================================================================
# OAUTH CONFIGURATION (Optional)
# ============================================================================

# Enable OAuth server
MIFOS_OAUTH_SERVER_ENABLED=false

# OAuth server URL (only used if OAuth is enabled)
MIFOS_OAUTH_SERVER_URL=https://your-oauth-server.example.com

# OAuth client ID (only used if OAuth is enabled)
MIFOS_OAUTH_CLIENT_ID=web-app

# ============================================================================
# VNEXT API CONFIGURATION (Optional)
# ============================================================================

VNEXT_API_URL=
VNEXT_API_PROVIDER=
VNEXT_API_VERSION=
VNEXT_INTERBANK_TRANSFERS=false

# ============================================================================
# OIDC PLUGIN CONFIGURATION (Optional)
# ============================================================================

FINERACT_PLUGIN_OIDC_ENABLED=false
FINERACT_PLUGIN_OIDC_BASE_URL=
FINERACT_PLUGIN_OIDC_CLIENT_ID=
FINERACT_PLUGIN_OIDC_API_URL=
FINERACT_PLUGIN_OIDC_FRONTEND_URL=

# ============================================================================

# ============================================================================
# DOCKER REGISTRY CONFIGURATION
# ============================================================================

REGISTRY=registry.digitalocean.com
REGISTRY_NAME=fineract-registry
VERSION_TAG=latest

